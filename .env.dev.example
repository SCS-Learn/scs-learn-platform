# Copy to .env.dev or .env.dev.personal and fill in credentials for that profile.
# Use the API URL, anon/publishable key and service_role/secret key from the
# same Supabase environment. For a local stack, get them from supabase status.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional developer course pull settings. The registry path must be absolute.
# Get the destination marker UUID and manifest SHA-256 from the maintainer.
# COURSE_BUNDLE_REGISTRY=
# COURSE_BUNDLE_DESTINATION_ID=
# COURSE_BUNDLE_MANIFEST_SHA256=

# Base URL this app is served from - used to build the Google OAuth redirect
# URI. Match the port Next.js listens on (for example, 3001 for personal dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets - never prefix with NEXT_PUBLIC_, never expose to the browser.
# Google Drive access - pick one, or set both (service account takes priority,
# unless the instructor has connected their own Google account below, which
# always takes priority over both):
#   - GOOGLE_SERVICE_ACCOUNT_KEY: full service-account JSON as one line. Lets
#     instructors share their folder privately with the service account's own
#     email instead of "Anyone with the link". No OAuth consent screen either
#     way - this is server-to-server, not user-delegated OAuth.
#   - GOOGLE_API_KEY: just needs the Drive API enabled on its Google Cloud
#     project. Only reads folders shared "Anyone with the link" - a key has no
#     identity of its own to share a private folder with.
# GOOGLE_API_KEY also powers the optional YouTube playlist import (paste a
# playlist link alongside the Drive folder to pull in lecture videos hosted on
# YouTube) - enable the YouTube Data API v3 on the same Google Cloud project
# for that key, in addition to the Drive API.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_API_KEY=

# Per-instructor Google OAuth ("Connect Google Drive") - lets the app read
# whatever the instructor's own account can already see, with no sharing step,
# and enables true per-slide rendering for a real .pptx via a temporary Google
# Slides conversion. From a Google Cloud OAuth 2.0 Client ID (Web application
# type); consent screen needs drive.readonly, drive.file, and
# presentations.readonly scopes, and a redirect URI of
# <NEXT_PUBLIC_SITE_URL>/api/google/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Per-instructor Cogniterra OAuth ("Connect Cogniterra") - lets
# lib/cogniterra/client.ts list a PRIVATE course's sections/lessons as the
# instructor's own account instead of anonymously, which Cogniterra silently
# refuses for private courses. From a Cogniterra OAuth2 application
# (cogniterra.org/oauth2/applications/) with "Client type" = Confidential and
# "Authorization grant type" = Authorization code, and a redirect URI of
# <NEXT_PUBLIC_SITE_URL>/api/cogniterra/oauth/callback.
COGNITERRA_OAUTH_CLIENT_ID=
COGNITERRA_OAUTH_CLIENT_SECRET=

ANTHROPIC_API_KEY=

# Optional integration overrides. Uncomment and fill in the ones you need.
# COGNITERRA_API_URL=
# COGNITERRA_OAUTH_BASE_URL=
# COGNITERRA_LAUNCH_URL=
# COGNITERRA_COURSE_ID=
# COGNITERRA_CONSUMER_KEY=
# COGNITERRA_SHARED_SECRET=
# LTI_TOOL_KID=
# LTI_TOOL_PRIVATE_KEY=

# Dev only. Set to 1 to build an imported course from Drive folder structure
# and filenames alone, with zero Claude calls - free and fast, for exercising
# the import, persistence, and UI path. The resulting course has one unit per
# subfolder, one lesson per file, no quizzes, and no playlist placement, so
# never set this when importing a course anyone will actually use.
DRIVE_IMPORT_SKIP_AI=
