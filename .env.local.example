NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL this app is served from - used to build the Google OAuth redirect
# URI. http://localhost:3000 in dev; set to the real deployed URL elsewhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets - never prefix with NEXT_PUBLIC_, never expose to the browser.
# Google Drive access - pick one, or set both (service account takes priority,
# unless the instructor has connected their own Google account below, which
# always takes priority over both):
#   - GOOGLE_SERVICE_ACCOUNT_KEY: full service-account JSON as one line. Lets
#     instructors share their folder privately with the service account's own
#     email instead of "Anyone with the link". No OAuth consent screen either
#     way - this is server-to-server, not user-delegated OAuth.
#   - GOOGLE_API_KEY: just needs the Drive API enabled on its Google Cloud
#     project. Only reads folders shared "Anyone with the link" - a key has no
#     identity of its own to share a private folder with.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_API_KEY=

# Per-instructor Google OAuth ("Connect Google Drive") - lets the app read
# whatever the instructor's own account can already see, with no sharing step,
# and enables true per-slide rendering for a real .pptx via a temporary Google
# Slides conversion. From a Google Cloud OAuth 2.0 Client ID (Web application
# type); consent screen needs drive.readonly, drive.file, and
# presentations.readonly scopes, and a redirect URI of
# <NEXT_PUBLIC_SITE_URL>/api/google/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Service-role Supabase key - used only for instructor_google_credentials,
# which holds a real third-party secret (an OAuth refresh token) and
# deliberately has no client-reachable RLS policy, unlike the rest of this
# stub-auth schema. Never expose to the browser. Find it in Supabase Dashboard
# > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
